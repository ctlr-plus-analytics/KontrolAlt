# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Serper Search API (used for Gate 0)
SERP_API_KEY=your_serper_api_key

# Redis URL (defaults to Docker redis container internally)
REDIS_URL=redis://localhost:6379/0

# Proxies (comma-separated proxy list, required for scraping)
PROXY_LIST=http://user:pass@host1:port,http://user:pass@host2:port

# Celery Configuration
# Controls the number of concurrent scraper worker processes. Defaults to 4.
CELERY_WORKER_CONCURRENCY=4

# Frontend Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Configuration
FRONTEND_ORIGIN=http://localhost:3000
